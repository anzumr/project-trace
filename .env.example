# Copy to .env in the repository root. Server entry points load it automatically.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Add-on 01: server-only secret (or legacy service_role) key enables result writes/public play.
# NEVER copy this variable/key into apps/client or any VITE_* variable.
# SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# 5A account verification uses the public key plus each player's verified bearer token.
# The server-only secret above is needed for the add-on's trusted result persistence.
# PORT is the backend port. Vite's development proxy defaults to 3001.
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set 1 to log authoritative HP once per second during live duels.
LOG_HP=0
# NODE_ENV=production requires an explicit ALLOWED_ORIGINS for npm start.
# npm start serves both assets and sockets on PORT (default 3001).
# Local production origins: http://localhost:3001,http://127.0.0.1:3001
